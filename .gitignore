.next-dev/
.expo/
*.log
*.tsbuildinfo

# Cache de ferramentas
.turbo/
coverage/

# Ambiente
.env
.env.local
.env.*.local

# Editores / SO
# O .vscode é versionado só no que vale para todo mundo: extensões recomendadas e as
# configurações que fazem o editor concordar com o CI (versão do TypeScript, LF, flat config).
# Preferência pessoal fica de fora.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Claude Code — agentes e MCPs são versionados; config local não
.claude/settings.local.json
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Playwright
test-results/
playwright-report/
blob-report/
.playwright/

# Fotos de perfil enviadas em desenvolvimento. Foto de pessoa não entra no repositório —
# nem por acidente, nem "só a de teste". Ver API_PHOTOS_DIR no .env.example.
apps/api/dados/
