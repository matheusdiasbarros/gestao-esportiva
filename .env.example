# Copie para .env e ajuste. O .env NUNCA é versionado.
# Toda variável listada aqui é validada no boot da API — se faltar, a aplicação não sobe.

NODE_ENV=development

# ---- API ----
API_PORT=3333
# Origens autorizadas a chamar a API, separadas por vírgula.
# 8081 e o servidor web do Expo, usado so para conferir as telas do app no navegador.
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ---- Banco ----
# Credenciais locais do docker-compose.yml. Em produção vêm do gerenciador de secrets.
DATABASE_HOST=localhost
# 5433, não 5432: o docker-compose expõe o Postgres nesta porta para não colidir com uma
# instalação nativa do PostgreSQL na máquina. Ver o comentário no docker-compose.yml.
DATABASE_PORT=5433
DATABASE_USER=gestao
DATABASE_PASSWORD=gestao_local
DATABASE_NAME=gestao_esportiva
# Habilitar apenas em ambiente gerenciado.
DATABASE_SSL=false
# Só para depurar consulta. Nunca true em produção — vaza dado em log.
DATABASE_LOGGING=false

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Autenticação ----
# Sem valor padrão no código de propósito: um segredo padrão que funciona em desenvolvimento é
# um segredo padrão que vai para produção junto com o resto. Gere o seu:
#   openssl rand -base64 48
JWT_SECRET=troque-isto-por-um-segredo-longo-de-verdade-com-32-mais
# 15 minutos. Curto porque os papéis viajam dentro do token e podem envelhecer.
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_WEB_DAYS=30
# 90 dias: o app do aluno é aberto duas vezes por semana.
REFRESH_TTL_MOBILE_DAYS=90
# true só com HTTPS. Em http://localhost o navegador descartaria o cookie e o login não
# persistiria, sem nenhuma mensagem de erro.
COOKIE_SECURE=false

# ---- E-mail ----
# Endereço público da web, usado para montar os links que vão dentro dos e-mails. Não dá para
# deduzir da requisição: quem envia é um trabalhador em segundo plano, sem requisição nenhuma.
APP_WEB_URL=http://localhost:3000
# Chave do Resend. **Opcional**: sem ela a API sobe e o e-mail vai para o log em vez de sumir,
# com o link inteiro — dá para seguir o fluxo sem provedor nenhum. Gere em resend.com/api-keys.
RESEND_API_KEY=
# Atenção: com o remetente de teste `onboarding@resend.dev` o Resend **só entrega para o e-mail
# da sua própria conta**. Qualquer outro destinatário volta 403. Para enviar a outras pessoas,
# verifique um domínio em resend.com/domains e troque o endereço abaixo.
RESEND_FROM="Gestao Esportiva <onboarding@resend.dev>"

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1

# ---- Seeds (só desenvolvimento) ----
# Usadas apenas por `pnpm --filter @gestao/api seed`. A API não lê nenhuma delas no boot.
# Não existe rota pública que crie administrador: promover uma conta é operação manual no
# banco enquanto não houver painel administrativo.
SEED_ADMIN_EMAIL=admin@gestao.local
SEED_ADMIN_PASSWORD=trocar-esta-senha
# Senha das contas de exemplo (Rodrigo, Ana, Marina, Carlos, Beatriz).
SEED_DEFAULT_PASSWORD=desenvolvimento1
